@page
@model Assignment.Pages.Incidents.IndexModel
@using Assignment.Models
@{
    ViewData["Title"] = "Incidents";
}
<h2>Incident reports</h2>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="q" value="@Model.Q" class="form-control" placeholder="Search ref / description / community" /></div>
    <div class="col-md-2"><select name="status" class="form-select" asp-items="Model.StatusOptions"><option value="">All statuses</option></select></div>
    <div class="col-md-2"><select name="risk" class="form-select" asp-items="Model.RiskOptions"><option value="">All risks</option></select></div>
    <div class="col-md-2"><select name="typeId" class="form-select" asp-items="Model.TypeOptions"><option value="">All types</option></select></div>
    <div class="col-md-3"><button class="btn btn-primary" type="submit">Filter</button> <a asp-page="Index" class="btn btn-link">Clear</a></div>
</form>
<table class="table table-striped table-sm" id="incidentTable">
    <thead><tr><th>Reference</th><th>Type</th><th>Risk</th><th>Location</th><th>Reported</th><th>Status</th><th>Officer</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td class="fw-bold">@i.ReferenceNumber</td>
            <td>@i.IncidentType?.Name</td>
            <td><span class="badge bg-@(i.RiskLevel == RiskLevel.Critical ? "danger" : i.RiskLevel == RiskLevel.High ? "warning text-dark" : "secondary")">@i.RiskLevel (@i.RiskScore)</span></td>
            <td class="small">@i.Latitude.ToString("F4"), @i.Longitude.ToString("F4")</td>
            <td class="small">@i.ReportedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
            <td>@i.Status</td>
            <td class="small">@(i.AssignedOfficer?.FullName ?? i.AssignedOfficer?.Email ?? "—")</td>
            <td class="text-nowrap">
                <a asp-page="Details" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">View location</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>document.addEventListener('DOMContentLoaded', () => { if (window.jQuery) jQuery('#incidentTable').DataTable(); });</script>
}
