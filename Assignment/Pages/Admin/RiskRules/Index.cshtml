@page
@model Assignment.Pages.Admin.RiskRules.IndexModel
@{
    ViewData["Title"] = "Risk rules";
}
<h2>Risk rules (configurable thresholds)</h2>
<p class="text-muted">Scoring is never hard-coded — tune the hotspot radius, time window and score thresholds here.</p>
<table class="table table-striped table-sm">
    <thead><tr><th>Name</th><th>Min count</th><th>Radius (km)</th><th>Window (h)</th><th>High ≥</th><th>Critical ≥</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Items)
    {
        <tr>
            <td>@r.Name</td><td>@r.MinIncidentCount</td><td>@r.RadiusKm</td><td>@r.TimeWindowHours</td>
            <td>@r.HighRiskThreshold</td><td>@r.CriticalRiskThreshold</td><td>@(r.IsActive ? "Yes" : "No")</td>
            <td><a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
