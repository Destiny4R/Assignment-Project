@page "{id:int}"
@model Assignment.Pages.Admin.RiskRules.EditModel
@{
    ViewData["Title"] = "Edit risk rule";
}
<h2>Edit risk rule</h2>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Item.Id" />
    <div class="mb-3"><label asp-for="Item.Name" class="form-label"></label><input asp-for="Item.Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Item.Description" class="form-label"></label><textarea asp-for="Item.Description" class="form-control"></textarea></div>
    <div class="row">
        <div class="col-6 mb-3"><label asp-for="Item.MinIncidentCount" class="form-label"></label><input asp-for="Item.MinIncidentCount" class="form-control" type="number" /></div>
        <div class="col-6 mb-3"><label asp-for="Item.RadiusKm" class="form-label"></label><input asp-for="Item.RadiusKm" class="form-control" type="number" step="0.1" /></div>
        <div class="col-6 mb-3"><label asp-for="Item.TimeWindowHours" class="form-label"></label><input asp-for="Item.TimeWindowHours" class="form-control" type="number" /></div>
        <div class="col-6 mb-3"><label asp-for="Item.HighRiskThreshold" class="form-label"></label><input asp-for="Item.HighRiskThreshold" class="form-control" type="number" /></div>
        <div class="col-6 mb-3"><label asp-for="Item.CriticalRiskThreshold" class="form-label"></label><input asp-for="Item.CriticalRiskThreshold" class="form-control" type="number" /></div>
        <div class="col-6 mb-3 form-check mt-4"><input asp-for="Item.IsActive" class="form-check-input" /><label asp-for="Item.IsActive" class="form-check-label"></label></div>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-page="Index" class="btn btn-link">Back</a>
</form>
