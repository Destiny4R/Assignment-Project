<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farmer/Herder Conflict Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Conflict Monitor</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-danger fw-bold" asp-page="/Report/Index">Report incident</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Dashboard/Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Map/Index">GIS Map</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Incidents/Index">Incidents</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Admin/Alerts/Index">Alerts</a></li>
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="/Admin/RiskRules/Index">Risk rules</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-page="/Admin/Users/Index">Users</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link text-muted small">@User.Identity.Name</span></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Account/Logout">Log out</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Account/Login">Officer log in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GIS Early Warning &amp; Conflict Monitoring - <a asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
